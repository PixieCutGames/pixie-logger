{
	"name": "@pixie-logger/api",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"db:migrate:local": "wrangler d1 migrations apply pixie-logs --local",
		"db:migrate:remote": "wrangler d1 migrations apply pixie-logs --remote",
		"db:list:local": "wrangler d1 migrations list pixie-logs --local",
		"keys": "tsx scripts/keys.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@pixie-logger/shared": "workspace:*",
		"hono": "^4.13.16",
		"jose": "^6.2.18"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0",
		"wrangler": "^4.162.0"
	}
}
